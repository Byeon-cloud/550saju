rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공유 리포트 — shareEnabled=true인 리포트는 누구나 읽기 가능
    match /reports/{rid} {
      allow read: if resource.data.shareEnabled == true;
    }

    // 유저 본인 데이터만 접근
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /profiles/{pid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /reports/{rid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{payid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /dailyFortune/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /shareLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // write는 Cloud Function에서만 (서버 사이드)
      }
    }
  }
}
