rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 2026-05-29 어드민 — 오너 uid 만 집계 데이터 접근. src/services/admin/adminConfig.ts 와 동일하게 유지.
    //   ⚠️ /admin 에서 본인 uid 확인 후 아래 목록 + adminConfig.ts 둘 다에 추가 + 재배포.
    function isOwner() {
      // 영구 오너 — 구글 로그인 이메일 (익명 uid 회전 문제 해결 · 2026-06-12)
      return request.auth != null && (
        request.auth.token.email == 'quswnsrl202@naver.com' ||
        request.auth.uid in [
        '6C4MSgYY5UMLBpsth0ehx3Pyj0K3', // 준기 · quswnsrl202@naver.com (구글 웹)
        '8Nda5XA4GwQfyjOLJk54i0ADdTb2', // 준기 · PC 웹 익명 세션 (편의)
        'biXRUeNouMhbtPVMDcaylJUqFqj1', // 준기 · saju500.app 익명 세션 (2026-06-11)
        '91KZVwV9foacOMJXMMZ9eWmZ4FQ2', // 준기 · 익명 세션 (2026-06-12 응급)
        'PWfJGV5QeYTkbNlhbXFYNWcfsnT2'  // 준기 · saju500.app 세션 (2026-06-23)
      ]);
    }

    // 이벤트 로그 (어드민 대시보드 소스) — 로그인 유저면 append, 읽기는 오너만.
    match /analytics/{eventId} {
      allow create: if request.auth != null;
      allow read: if isOwner();
    }

    // AI 토큰 사용량 로그 (C7 · 2026-06-10) — 쓰기는 서버(admin SDK)만, 읽기는 어드민 대시보드(오너)만.
    match /aiUsage/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 어드민 매출 집계 (2026-06-12) — collectionGroup('payments') 쿼리는 별도 경로 룰 필요
    //   (기존 users/{uid}/payments 룰만으론 collection-group 쿼리 권한 거부 → 매출 ₩0 원인)
    match /{path=**}/payments/{payid} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 어드민 콘텐츠 생성 집계 (2026-06-12) — 서버가 최상위 reports 에 기록 (admin SDK 쓰기).
    //   collectionGroup('reports') 조회용 룰 부재 → 어드민 '콘텐츠 생성 누적' 0 으로 나오던 원인.
    match /{path=**}/reports/{rid} {
      allow read: if isOwner();
    }

    // 어드민 오늘운세 분포 (2026-06-12) — users/*/dailyFortune/{date} collectionGroup 집계
    match /{path=**}/dailyFortune/{date} {
      allow read: if isOwner();
    }

    // CS 보상 장부 (2026-06-11) — 접근은 claimCompensation callable(admin SDK)로만. 클라 직접 접근 차단.
    match /compensations/{deviceId} {
      allow read, write: if false;
    }

    // LIVE BEST 실시간 집계 (2026-06-02 D3) — 캐시는 공개 읽기, 쓰기/카운트/쿨다운은 Cloud Functions(admin) 전용.
    match /liveBestCache/{doc} {
      allow read: if true;       // HomePage 공개 읽기
      allow write: if false;     // 서버(admin SDK)만 — recordTopicView/aggregateTopicTop5
    }
    // 띠별 오늘의 운세 (2026-10-15) — 서버가 하루 한 번 만들고, 홈은 공개 읽기만.
    // 2026-10-17 궁합 보내기 — 링크(id)를 아는 사람만 한 건씩 읽는다. 목록 조회와 클라이언트 쓰기는 막는다(createCompatShare 함수만 쓴다)
    match /compatShares/{id} {
      allow get: if true;
      allow list, write: if false;
    }
    match /ttiFortune/{day} {
      allow read: if true;
      allow write: if false;
    }
    match /liveBestCounts/{doc} {
      allow read, write: if false; // 서버 전용 (어뷰징 방어 — 클라 직접 증가 차단)
    }
    match /liveBestCooldown/{doc} {
      allow read, write: if false; // 서버 전용
    }

    // 점진 로딩 (2026-07-01) — 생성 중 서버가 그룹별 증분 write, 클라가 onSnapshot 구독.
    //   read: 본인 uid 만 (미존재 doc 은 구독 타이밍상 허용 — 데이터 없어 무해) / write: 서버(admin SDK)만.
    //   progressId 는 추측 불가 UUID + uid 일치 검사로 타 유저 리포트 내용 유출 차단.
    match /progress/{progressId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false; // writeGroupProgress(admin SDK)만
    }

    // 후기 (2026-10-10) — 결과를 다 읽은 사람이 남김. 본인 create 만(수정·삭제 불가 · 필드/길이 고정).
    //   공개 읽기는 오너 승인(status=approved) + 공개 동의(consentPublic) 분만. 승인/숨김은 오너만(status 만 변경).
    //   이름·나이·생일은 받지 않는다 (src/services/reviews.ts).
    match /reviews/{rid} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'contentType', 'contentLabel', 'rating', 'text', 'consentPublic', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.contentType is string && request.resource.data.contentType.size() <= 20
        && request.resource.data.contentLabel is string && request.resource.data.contentLabel.size() <= 20
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.consentPublic is bool
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isOwner() || (resource.data.status == 'approved' && resource.data.consentPublic == true);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'hidden', 'pending'];
      allow delete: if false;
    }

    // 어드민 전역 집계 (collectionGroup) — 유저 카운트 + 결제 + 리포트
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow list: if isOwner(); // 어드민 유저 수 집계
      // 2026-05-29 잔액 보안 (Phase 1) — 금전 필드(balance/totalCharged/totalSpent/bonusBalance/unBalance)는
      //   Cloud Function(Admin SDK)만 기록. 클라이언트 콘솔에서 balance 무한충전하던 구멍 차단.
      //   create: 금전 필드 없이만 생성 / update: 금전 필드 변경 시 거부. (서버 Admin SDK 는 rules 우회)
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['balance', 'totalCharged', 'totalSpent', 'bonusBalance', 'unBalance']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['balance', 'totalCharged', 'totalSpent', 'bonusBalance', 'unBalance']);

      match /profiles/{pid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // 잔액 미러 등 클라 상태 스냅샷 (2026-08-13 기기 여권) — 자기신고 성격, 서버 지급 판정에 미사용.
      //   users 문서의 금전 필드 차단(위)은 그대로 — 이 서브컬렉션은 소실 복원용 참고값일 뿐.
      match /state/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /reports/{rid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isOwner();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // ─── E13 결제 원자성 (2026-04-22) ───
      // status: pending → confirmed | failed | needs_reconciliation 전이는 Cloud Functions 전용.
      // 클라이언트 직접 write 차단 → 중복 지급 우회 공격 방지.
      // 히스토리 조회는 본인 uid 에 한해 허용.
      match /payments/{payid} {
        // 2026-05-28 PM CRITICAL — 클라이언트 write 차단 (결제 어뷰징 방지).
        //   payments 는 서버 (Cloud Function: confirmPayment / grantPurchase) 만 작성 권한.
        //   2026-05-29 — 오너는 전체 결제 집계 read 가능 (어드민 매출 대시보드).
        allow read: if (request.auth != null && request.auth.uid == uid) || isOwner();
        allow write: if false;
      }
      // 2026-10-16 운 회수 지시 (포트원 취소 → syncPortoneCancellations 가 작성). 기기가 읽고 반영한 뒤
      //   applied 를 true 로만 바꿀 수 있다 (차감량, 사유는 못 고침, 되돌리기(false)와 생성과 삭제는 금지).
      match /balanceAdjustments/{aid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isOwner();
        allow update: if request.auth != null && request.auth.uid == uid
          && resource.data.applied == false
          && request.resource.data.applied == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applied', 'appliedAt']);
        allow create, delete: if false;
      }
      match /dailyFortune/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /shareLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // write는 Cloud Function에서만 (서버 사이드)
      }

      // ─── 이벤트 탭 v4.1 (2026-04-21) ───
      // 모든 쓰기는 Cloud Functions admin SDK만. 클라이언트는 읽기 전용.
      match /attendance/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /streakAttendance/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /inviteEvents/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /shareEvents/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /rewardClaims/{claimId} {
        // 블록 5 "누적 운" 집계용 쿼리 허용 (where · orderBy · limit)
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // 서버 전용
      }
    }
  }
}
