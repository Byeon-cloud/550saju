{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Dev (Frontend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Vite Preview (Built)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "Firebase Emulators (Functions)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve"],
      "cwd": "functions",
      "port": 5001,
      "autoPort": true
    }
  ]
}
