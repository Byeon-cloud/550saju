    "rewrites": [
      {
        "source": "/api/seo-hit",
        "function": "seoHit"
      },
      {
        "source": "/api/saju-card-og.png",
        "function": "renderSajuCardOgImage"
      },
      {
        "source": "/saju-card/**",
        "function": "renderSajuCardOg"
      },
      {
        "source": "/share/**",
        "function": "renderShareOg"
      },
      {
        "source": "/mail/unsub",
        "function": "unsubscribeMail"
      },
      {
        "source": "/unse/today/ilju",
        "function": "renderIljuToday"
      },
      {
        "source": "/unse/today/ilju/**",
        "function": "renderIljuToday"
      },
      {
        "source": "/unse/today",
        "function": "renderTtiToday"
      },
      {
        "source": "/unse/today/**",
        "function": "renderTtiToday"
      },
      {
        "source": "/og/tti/**",
        "function": "ttiOgImage"
      },
      { "source": "/daily", "destination": "/_shell/daily.html" },
      { "source": "/dream", "destination": "/_shell/dream.html" },
      { "source": "/premium", "destination": "/_shell/premium.html" },
      { "source": "/tojung", "destination": "/_shell/tojung.html" },
      { "source": "/compat", "destination": "/_shell/compat.html" },
      { "source": "/topic/love", "destination": "/_shell/topic-love.html" },
      { "source": "/topic/wealth", "destination": "/_shell/topic-wealth.html" },
      { "source": "/topic/reunion", "destination": "/_shell/topic-reunion.html" },
      { "source": "/topic/exam", "destination": "/_shell/topic-exam.html" },
      { "source": "/topic/marriage", "destination": "/_shell/topic-marriage.html" },
      { "source": "/topic/career", "destination": "/_shell/topic-career.html" },
      { "source": "/terms", "destination": "/_shell/terms.html" },
      { "source": "/privacy", "destination": "/_shell/privacy.html" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "ALLOWALL"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|gif|svg|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400"
          }
        ]
      },
      {
        "source": "/og/tti/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/api/saju-card-og.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ]
  }
}
