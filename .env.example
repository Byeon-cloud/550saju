# Firebase (클라이언트)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=saju-550
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GA4
VITE_GA4_MEASUREMENT_ID=

# AI API Keys (서버 전용 — Firebase Functions .env에 설정)
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# 토스 프로모션 (2026-05-09)
# 출시 전(테스트): 미설정 또는 0 → TEST_ prefix 코드로 grantPromotionReward 호출
# 출시 후(LIVE):  VITE_PROMO_LIVE=1 → 찐 프로모션 코드로 호출 (실 포인트 지급)
VITE_PROMO_LIVE=1

# Premium SSE 스트리밍 (2026-05-19 종합사주 SSE 활성)
# 결제 직후 ResultPage 에서 그룹 A/B/C 도착마다 점진 렌더 (LoadingPage 거치지 않음).
# false 일 때는 callable 1회 호출 폴백 (단일 60-90초 대기 후 결과 점프).
# 출시 빌드는 반드시 true 권장.
VITE_USE_PREMIUM_STREAM=true

# 홈 v5 (Path 분기 A/B/C/D) — 1% ramp 대기 중. 출시 빌드는 false (HomePage v4 유지).
VITE_HOME_V5_ENABLED=false

# Firebase Functions 에뮬레이터 (개발 전용)
# true 시 localhost:5001 로 callable/onRequest 라우팅. 운영 빌드 false 또는 미설정.
VITE_USE_FUNCTIONS_EMULATOR=false

# QA 전용 디버그 도구(내정보 5탭 시트의 운 충전) 노출. 출시 빌드에서는 반드시 비워둘 것.
VITE_DEBUG_TOOLS=
