# Firebase Functions Emulator — 로컬 secret 파일.
# 실제 사용 시 파일명 `.secret.local` 로 복사 후 값 채움.
# .gitignore 되어 있음. 절대 커밋 금지.
#
# 생성: cp .secret.local.example .secret.local
# 그 다음 아래 값을 실제 key 로 교체.
#
# prod Firebase Secrets 와는 별개 파일. emulator 로컬 전용.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Toss (로컬 테스트 시 생략 가능 — 결제 emulator 실호출 안 함)
# TOSS_MTLS_CERT=
# TOSS_MTLS_KEY=
# TOSS_DECRYPT_KEY=
# TOSS_DECRYPT_AAD=
# TOSS_PAYMENTS_SECRET_KEY=
# TOSS_DISCONNECT_AUTH=
